{
  "name": "sesese-se",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=12"
  },
  "packageManager": "npm@12.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro sync && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro sync && tsc --noEmit && astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run && python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run test:browser",
    "verify": "npm run format:check && npm run test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "astro": "7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260730.1": true
  }
}
